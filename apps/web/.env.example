VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: full API base URL for the backend (used in production builds,
# e.g. https://your-backend.railway.app or https://api.example.com).
# In local dev this is proxied to http://localhost:4000 via vite.config.ts,
# so you only need to set this when the frontend and backend are hosted
# separately.
# VITE_API_URL=https://your-backend.example.com
