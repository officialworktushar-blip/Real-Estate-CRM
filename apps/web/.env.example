VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: API base URL for the backend (used in production builds,
# e.g. https://oryntal-backend.onrender.com or https://api.example.com).
# /api is appended automatically if missing, so both
# https://your-backend.example.com and https://your-backend.example.com/api work.
# In local dev the default is http://localhost:4000/api,
# so you only need to set this when the frontend and backend are hosted
# separately.
# VITE_API_URL=https://your-backend.example.com
